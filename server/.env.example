# Generate with: openssl rand -hex 32
AURA_API_TOKEN=replace-with-a-long-random-token
AURA_DB_PATH=./data/aura.db
AURA_PUBLIC_URL=http://127.0.0.1:8000
AURA_DATA_DIR=./data
AURA_MAX_AUDIO_BYTES=104857600
AURA_ADMIN_USER=aura
AURA_ADMIN_PASSWORD=replace-with-a-second-long-random-secret
DOMAIN=aura.example.com

# Phase 4 transcription and extraction. Leave blank for manual transcripts.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Calendar providers. Leave an adapter blank to disable it.
CALENDAR_SYNC_MINUTES=10
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=common
MS_GRAPH_TOKEN_CACHE=./data/ms-token-cache.json
